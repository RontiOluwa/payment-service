# Only used when STORAGE_DRIVER=file. Path to the JSON data file.
# Defaults to ./data/payments.json if unset.
PAYMENTS_DATA_FILE=./data/payments.json

# Port the HTTP server listens on. Defaults to 3000 if unset.
PORT=1000

# Redis connection, used by BullMQ for asynchronous payment processing.
# Start Redis locally with: docker compose up -d
REDIS_HOST=localhost
REDIS_PORT=6379
API_KEY=dev-local-api-key